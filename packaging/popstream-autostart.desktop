[Desktop Entry]
Type=Application
Version=1.0
Name=PopStream
Comment=Keep the Stream Deck running after login
Exec=@ROOT@/packaging/popstream --tray
Path=@ROOT@
Icon=@ICON@
Terminal=false
Categories=Utility;Settings;
StartupNotify=false
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=3
Hidden=false
